# Base URL of the deployed backend (HTTPS, no trailing slash). Expo inlines EXPO_PUBLIC_* values at build time.
# Android emulator talking to a backend on your computer: http://10.0.2.2:4000
# Physical phone on the same Wi-Fi: http://<your-computer-LAN-ip>:4000
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com
