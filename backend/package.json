{
  "name": "pms-backend",
  "version": "1.0.0",
  "description": "REST API for the Project Management System (shared by web and mobile clients)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  }
}
