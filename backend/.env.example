# --- Server ---
PORT=4000
NODE_ENV=development
# Run migrations automatically on boot (set to false to run `npm run migrate` yourself).
AUTO_MIGRATE=true

# --- Database (PostgreSQL 13+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pms
# Set to true for managed databases that require TLS (Neon, Supabase, Render, ...).
DATABASE_SSL=false

# --- Auth ---
# REQUIRED in production: a random string of at least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- CORS / proxy ---
# Comma-separated list of allowed browser origins (your deployed web app URL). Mobile apps send no Origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Number of reverse proxies in front of the API (1 on Render/Railway/Fly/Heroku).
TRUST_PROXY=0

# --- Logging ---
LOG_LEVEL=debug

# --- Rate limiting (all optional) ---
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=900000
