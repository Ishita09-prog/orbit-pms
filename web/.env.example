# Base URL of the backend API (no trailing slash). Used at build time.
VITE_API_URL=http://localhost:4000

# Optional: replace the animated background with your own image or video.
# Put the file in web/public/media/ and reference it like this:
# VITE_BG_IMAGE=/media/background.jpg
# VITE_BG_VIDEO=/media/background.mp4

# Optional: show a "Use demo account" button on the login screen (needs the seeded demo user).
# VITE_SHOW_DEMO=true
